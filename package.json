{
  "name": "ifdef-pathfinder",
  "displayName": "IFDEF Pathfinder",
  "description": "Show nested conditional path, highlights and folds #ifdef sections in C/C++ code",
  "version": "1.1.0",
  "publisher": "arieljacob",
  "icon": "Marketing/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:cuda-cpp",
    "onLanguage:objective-c",
    "onLanguage:objective-cpp",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/extension.js",
    "Marketing/icon.png",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
    "configuration": {
      "title": "IFDEF Pathfinder",
      "properties": {
        "ifdefPathfinder.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": [
            "c",
            "cpp",
            "cuda-cpp",
            "objective-c",
            "objective-cpp"
          ],
          "markdownDescription": "[Language identifiers](https://code.visualstudio.com/docs/languages/identifiers) of the files that the extension works in. Other preprocessed languages, such as `glsl` or `hlsl`, can be added."
        },
        "ifdefPathfinder.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Shows the enclosing conditions above each nested `#if`, `#ifdef` and `#ifndef`. Clicking a condition goes to its directive."
        },
        "ifdefPathfinder.inlineHints.directives": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "elif",
              "else",
              "endif"
            ],
            "enumDescriptions": [
              "`#elif` and its variants show the condition under which the branch is compiled.",
              "`#else` shows the negation of every earlier branch.",
              "`#endif` shows the condition of the block it closes."
            ]
          },
          "uniqueItems": true,
          "default": [
            "elif",
            "else",
            "endif"
          ],
          "markdownDescription": "Directives that show their condition at the end of the line. An empty list turns these hints off."
        },
        "ifdefPathfinder.inlineHints.hideWhenEndifCommented": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Leaves out the hint on an `#endif` whose comment already names the condition, such as `#endif // FOO`."
        },
        "ifdefPathfinder.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Shows the conditions in effect at the cursor in the status bar."
        }
      }
    },
    "colors": [
      {
        "id": "ifdefPathfinder.depth1Foreground",
        "description": "Color of hints for blocks at nesting depth 1, 7, 13 and so on.",
        "defaults": {
          "dark": "editorBracketHighlight.foreground1",
          "light": "editorBracketHighlight.foreground1",
          "highContrast": "editorBracketHighlight.foreground1",
          "highContrastLight": "editorBracketHighlight.foreground1"
        }
      },
      {
        "id": "ifdefPathfinder.depth2Foreground",
        "description": "Color of hints for blocks at nesting depth 2, 8, 14 and so on.",
        "defaults": {
          "dark": "editorBracketHighlight.foreground2",
          "light": "editorBracketHighlight.foreground2",
          "highContrast": "editorBracketHighlight.foreground2",
          "highContrastLight": "editorBracketHighlight.foreground2"
        }
      },
      {
        "id": "ifdefPathfinder.depth3Foreground",
        "description": "Color of hints for blocks at nesting depth 3, 9, 15 and so on.",
        "defaults": {
          "dark": "editorBracketHighlight.foreground3",
          "light": "editorBracketHighlight.foreground3",
          "highContrast": "editorBracketHighlight.foreground3",
          "highContrastLight": "editorBracketHighlight.foreground3"
        }
      },
      {
        "id": "ifdefPathfinder.depth4Foreground",
        "description": "Color of hints for blocks at nesting depth 4, 10, 16 and so on. Defaults to the first bracket color, because the theme's fourth bracket color is transparent unless the theme sets it.",
        "defaults": {
          "dark": "editorBracketHighlight.foreground1",
          "light": "editorBracketHighlight.foreground1",
          "highContrast": "editorBracketHighlight.foreground1",
          "highContrastLight": "editorBracketHighlight.foreground1"
        }
      },
      {
        "id": "ifdefPathfinder.depth5Foreground",
        "description": "Color of hints for blocks at nesting depth 5, 11, 17 and so on. Defaults to the second bracket color, because the theme's fifth bracket color is transparent unless the theme sets it.",
        "defaults": {
          "dark": "editorBracketHighlight.foreground2",
          "light": "editorBracketHighlight.foreground2",
          "highContrast": "editorBracketHighlight.foreground2",
          "highContrastLight": "editorBracketHighlight.foreground2"
        }
      },
      {
        "id": "ifdefPathfinder.depth6Foreground",
        "description": "Color of hints for blocks at nesting depth 6, 12, 18 and so on. Defaults to the third bracket color, because the theme's sixth bracket color is transparent unless the theme sets it.",
        "defaults": {
          "dark": "editorBracketHighlight.foreground3",
          "light": "editorBracketHighlight.foreground3",
          "highContrast": "editorBracketHighlight.foreground3",
          "highContrastLight": "editorBracketHighlight.foreground3"
        }
      }
    ],
    "commands": [
      {
        "command": "ifdefPathfinder.foldAll",
        "title": "Collapse All in Page",
        "category": "IFDEF Pathfinder"
      },
      {
        "command": "ifdefPathfinder.foldSection",
        "title": "Collapse All Under This Section",
        "category": "IFDEF Pathfinder"
      },
      {
        "command": "ifdefPathfinder.unfoldAll",
        "title": "Expand All",
        "category": "IFDEF Pathfinder"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "ifdefPathfinder.foldAll",
          "when": "editorLangId in ifdefPathfinder.languages"
        },
        {
          "command": "ifdefPathfinder.foldSection",
          "when": "editorLangId in ifdefPathfinder.languages"
        },
        {
          "command": "ifdefPathfinder.unfoldAll",
          "when": "editorLangId in ifdefPathfinder.languages"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run rm-out && npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:node:* --format=cjs --platform=node --tree-shaking=true --drop:console --drop:debugger",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "compile": "tsc -p ./",
    "rm-out": "node -e \"fs.rmSync('out',{recursive:true,force:true})\"",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "tsc -p ./ --outDir out/unit && mocha \"out/unit/test/**/*.test.js\""
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tanffn/IFDEF-Pathfinder.git"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
