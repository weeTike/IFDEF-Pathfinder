{
  "name": "ifdef-pathfinder",
  "displayName": "IFDEF Pathfinder",
  "description": "Show nested conditional path, highlights and folds #ifdef sections in C/C++ code",
  "version": "1.0.0",
  "publisher": "arieljacob",
  "icon": "Marketing/icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Ifdef Highlighter",
      "properties": {
        "ifdefHighlighter.showDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Toggle decorations for #ifdef sections."
        },
        "ifdefHighlighter.showFullPath": {
          "type": "boolean",
          "default": false,
          "description": "Show full path in decorations."
        }
      }
    },
    "commands": [
      {
        "command": "extension.collapseAllIfdefs",
        "title": "IFDEFs - Collapse All in Page"
      },
      {
        "command": "extension.collapseIfdefsInSection",
        "title": "IFDEFs - Collapse All Under This Section"
      },
      {
        "command": "extension.expandAll",
        "title": "IFDEFs - Expand All"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.preprocessor.injection",
        "path": "./syntaxes/preprocessor.json",
        "injectTo": [
          "source.c",
          "source.cpp"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run rm-out && npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --external:node:* --format=cjs --platform=node --tree-shaking=true --drop:console --drop:debugger",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "compile": "tsc -p ./",
    "rm-out": "node -e \"fs.rmSync('out',{recursive:true,force:true})\"",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src syntaxes"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tanffn/IFDEF-Pathfinder.git"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
